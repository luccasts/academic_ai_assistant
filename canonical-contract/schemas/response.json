{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CanonicalResponse",
  "type": "object",
  "required": [
    "conversation_id",
    "status",
    "message"
  ],
  "properties": {
    "conversation_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": ["success", "error"]
    },
    "message": {
      "type": "string"
    },
    "agent_id": {
      "type": "string"
    },
    "tool_calls": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tool_id": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["success", "error"]
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error_code": {
      "type": ["string", "null"]
    }
  }
}